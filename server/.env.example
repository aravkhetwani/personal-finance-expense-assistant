# Copy to .env and adjust. Everything is optional for local development.

PORT=4000
NODE_ENV=development            # set to "production" when deployed
APP_URL=http://localhost:4000   # used in password-reset links (use http://localhost:5173 when running the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secrets. If omitted, random values are generated once and stored in server/data/ (back that folder up!).
# JWT_SECRET=<64 hex chars>
# ENCRYPTION_KEY=<64 hex chars = 32 bytes, AES-256-GCM key for data at rest>
#   generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Email (SI-1 / CI-2). Without SMTP_HOST, emails are logged to the console + "outbox" table,
# and OTP / reset codes are returned in API responses (development only).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Finance Assistant <no-reply@example.com>"

# Optional administrator created on startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe-LongPassword1

# Sessions (NFR-SEC-004)
SESSION_TIMEOUT_MIN=30
SESSION_MAX_HOURS=12

# Transport security (CI-1). Either terminate TLS at a reverse proxy (recommended) and set the two proxy
# options, or give Node a certificate directly.
# TRUST_PROXY=true
# FORCE_HTTPS=true
# TLS_KEY_FILE=/path/to/privkey.pem
# TLS_CERT_FILE=/path/to/fullchain.pem

# Rate limits (requests per 15 min per IP)
AUTH_RATE_LIMIT=40
API_RATE_LIMIT=2000

# Web Push (optional): VAPID keys are generated automatically into server/data/.vapid.json if these are not set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
